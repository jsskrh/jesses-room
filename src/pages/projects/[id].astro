---
import { getCollection, type CollectionEntry } from "astro:content";
import CaseStudy from "../../components/CaseStudy.astro";
import Reading from "../../layouts/Reading.astro";
import { site } from "../../site";

// Each case study also has a page of its own: for links from elsewhere, and
// for visitors without the room, where the books can't open.
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary } = project.data;
---

<Reading
  title={`${title} · ${site.title}`}
  description={summary[0]}
  heading={title}
  accent="green"
  back={`/#${project.id}`}
>
  <CaseStudy project={project} />
</Reading>
